
#include <stdio.h>

int main()
{
    int n, digit, sum = 0, temp;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    if(n < 0)
        n = -n;

    while(n > 0)
    {
        digit = n % 10;
        sum = sum + digit;
        n = n / 10;
    }

    printf("Sum of digits of %d = %d", temp, sum);

    return 0;
}
