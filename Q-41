
#include <stdio.h>

int main()
{
    int n, temp, first, last;
    int divisor = 1, digits = 0, middle, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(n < 0)
    {
        printf("Enter a positive number");
        return 0;
    }

    temp = n;

    last = n % 10;

    while(temp >= 10)
    {
        temp = temp / 10;
        divisor = divisor * 10;
    }

    first = temp;

    if(divisor == 1)
    {
        result = n;
    }
    else
    {
        middle = (n % divisor) / 10;

        result = last * divisor + middle * 10 + first;
    }

    printf("Number after swapping = %d", result);

    return 0;
}
