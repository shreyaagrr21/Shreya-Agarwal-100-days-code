
#include <stdio.h>

int main()
{
    int a, b, i, hcf = 1;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    if(a == 0 && b == 0)
    {
        printf("HCF is not defined");
    }
    else
    {
        if(a < 0)
            a = -a;

        if(b < 0)
            b = -b;

        for(i = 1; i <= a && i <= b; i++)
        {
            if(a % i == 0 && b % i == 0)
            {
                hcf = i;
            }
        }

        printf("HCF = %d", hcf);
    }

    return 0;
}
