
#include <stdio.h>

int main()
{
    int n, digit;
    long long complement = 0, place = 1;

    printf("Enter a binary number: ");
    scanf("%d", &n);

    if(n < 0)
    {
        printf("Enter a positive binary number");
        return 0;
    }

    if(n == 0)
    {
        printf("1's complement = 1");
        return 0;
    }

    while(n > 0)
    {
        digit = n % 10;

        if(digit == 0)
        {
            complement = complement + 1 * place;
        }
        else if(digit == 1)
        {
            complement = complement + 0 * place;
        }
        else
        {
            printf("Invalid binary number");
            return 0;
        }

        place = place * 10;
        n = n / 10;
    }

    printf("1's complement = %lld", complement);

    return 0;
}
