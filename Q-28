#include <stdio.h>

int main()
{
    int n, i, product = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++)
    {
        if(i % 2 == 0)
        {
            product = product * i;
        }
    }

    printf("Product of even numbers = %d", product);

    return 0;
}
