#include <stdio.h>

int main()
{
    int n;

    printf("Enter an integer: ");
    scanf("%d", &n);

    if (n > 0)
    {
        printf("%d is Positive", n);
    }
    else
    {
        if (n < 0)
        {
            printf("%d is Negative", n);
        }
        else
        {
            printf("The number is Zero");
        }
    }

    return 0;
}
