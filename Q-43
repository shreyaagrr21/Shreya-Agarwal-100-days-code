
#include <stdio.h>

int main()
{
    int n, original, digit;
    int fact, sum = 0, i;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;

    if(n < 0)
    {
        printf("Not a Strong Number");
    }
    else
    {
        while(n > 0)
        {
            digit = n % 10;

            fact = 1;

            for(i = 1; i <= digit; i++)
            {
                fact = fact * i;
            }

            sum = sum + fact;

            n = n / 10;
        }

        if(sum == original)
        {
            printf("Strong Number");
        }
        else
        {
            printf("Not a Strong Number");
        }
    }

    return 0;
}
